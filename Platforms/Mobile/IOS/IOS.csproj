    <ItemGroup>
        <ProjectReference Include="$(SolutionDir)\App\App.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Hybrid2D.IOS" Version="*" />
    </ItemGroup>

</Project>